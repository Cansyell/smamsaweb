classDiagram
    %% ========================================
    %% COMPLETE CLASS DIAGRAM
    %% Sistem PPDB SMA MSA - SAW & AHP
    %% ========================================
    
    %% ========================================
    %% CORE ENTITIES
    %% ========================================
    
    class User {
        +int id
        +string name
        +string email
        +string password
        +string role
        +datetime email_verified_at
        +string remember_token
        +timestamps
        --
        +hasOne student()
        +hasMany calculatedSawResults()
        +hasMany announcements()
        +hasMany validationLogs()
        --
        +bool hasRole(role)
        +bool isCommittee()
        +bool isStudent()
        +bool isAdmin()
    }

    class Student {
        +int id
        +int user_id
        +int academic_year_id
        +string student_id
        +string nisn
        +string full_name
        +string father_name
        +string mother_name
        +string gender
        +string place_of_birth
        +date date_of_birth
        +text address
        +string phone_number
        +string previous_school
        +int graduation_year
        +string kip_number
        +string specialization
        +text preference_reason
        +int quran_memorization
        +string language_interest
        +string validation_status
        +text validation_notes
        +datetime validated_at
        +int ranking
        +string final_class_type
        +string final_status
        +int resubmission_count
        +datetime resubmitted_at
        +text resubmission_notes
        +bool has_pending_resubmission
        +timestamps
        --
        +belongsTo user()
        +belongsTo academicYear()
        +hasOne testScore()
        +hasMany documents()
        +hasOne reportGrade()
        +hasOne finalScore()
        +hasMany sawResults()
        +hasMany criterionValues()
        +hasMany validationLogs()
        --
        +bool isPersonalDataCompleted()
        +bool isReportGradeCompleted()
        +bool isDocumentsCompleted()
        +bool isSpecializationCompleted()
        +bool isRegistrationCompleted()
        +array getRegistrationProgress()
        +bool hasSawCalculation()
        +array canEditData()
        +bool canResubmit()
        +bool isAccepted()
        +string getAcceptanceStatus()
        +array getRankingInfo()
        +string getGenderLabelAttribute()
        +string getStatusBadgeAttribute()
        +int getAgeAttribute()
    }

    class AcademicYear {
        +int id
        +string year
        +string name
        +date start_date
        +date end_date
        +bool is_active
        +text description
        +string result_status
        +datetime published_at
        +int published_by
        +text publish_notes
        +timestamps
        --
        +hasMany students()
        +hasMany specializationQuotas()
        +hasOne activeSpecializationQuota()
        +hasMany sawResults()
        +hasMany ahpMatrices()
        +hasMany criterionWeights()
        --
        +bool activate()
        +bool deactivate()
        +bool isActive()
        +bool isCurrent()
        +bool isUpcoming()
        +bool isPast()
        +string getStatusBadgeAttribute()
        +string getFullYearAttribute()
        +int getStudentCountAttribute()
        +static getActiveYear()
        +static getCurrentYear()
    }

    class SpecializationQuota {
        +int id
        +int academic_year_id
        +int tahfiz_quota
        +int language_quota
        +int regular_quota
        +bool is_active
        +timestamps
        --
        +belongsTo academicYear()
        --
        +bool activate()
        +bool deactivate()
        +int getQuotaBySpecialization(spec)
        +array getQuotasArray()
        +bool hasAvailableQuota(spec, required)
        +string getStatusBadgeAttribute()
        +int getTotalQuotaAttribute()
        +float getTahfizPercentageAttribute()
        +float getLanguagePercentageAttribute()
        +float getRegularPercentageAttribute()
        +static getActiveByAcademicYear(yearId)
        +static getQuotaInformation(yearId)
    }

    %% ========================================
    %% STUDENT DATA
    %% ========================================

    class ReportGrade {
        +int id
        +int student_id
        +decimal islamic_studies
        +decimal indonesian_language
        +decimal english_language
        +decimal ppkn
        +decimal mtk
        +decimal ipa
        +decimal seni_budaya
        +decimal penjas
        +decimal prakarya
        +decimal average_grade
        +timestamps
        --
        +belongsTo student()
        --
        +static createGrade(data)
        +bool updateGrade(data)
        +bool getIsCompleteAttribute()
        +string getGradeStatusAttribute()
        +string getGradeBadgeAttribute()
    }

    class Document {
        +int id
        +int student_id
        +string document_type
        +string file_name
        +string file_path
        +string validation_status
        +text notes
        +timestamps
        --
        +belongsTo student()
        --
        +scopePending()
        +scopeValid()
        +scopeInvalid()
        +scopeByType(type)
        --
        +static createDocument(data)
        +bool updateDocument(data)
        +bool validateDocument(status, notes)
        +bool deleteDocument()
        +bool isPending()
        +bool isValid()
        +bool isInvalid()
        +string getStatusBadgeAttribute()
        +string getTypeLabelAttribute()
        +string getFileUrlAttribute()
        +string getFileSizeAttribute()
    }

    class TestScore {
        +int id
        +int student_id
        +decimal quran_achievement
        +decimal quran_reading
        +decimal interview
        +decimal public_speaking
        +decimal dialogue
        +decimal average_score
        +int input_by
        +timestamps
        --
        +belongsTo student()
        +belongsTo inputBy()
        --
        +static createTestScore(data)
        +bool updateTestScore(data)
        +bool calculateAverage()
        +bool isComplete()
        +bool isPassing(passingGrade)
        +string getFormattedAverageAttribute()
        +string getGradeAttribute()
        +string getGradeBadgeAttribute()
    }

    class ValidationLog {
        +int id
        +int student_id
        +int actor_id
        +string action
        +string previous_status
        +string new_status
        +text notes
        +int resubmission_count
        +json metadata
        +timestamps
        --
        +belongsTo student()
        +belongsTo actor()
        --
        +string getActionLabelAttribute()
        +string getActionBadgeAttribute()
    }

    %% ========================================
    %% AHP & CRITERIA
    %% ========================================

    class Criteria {
        +int id
        +string code
        +string name
        +string specialization
        +string attribute_type
        +string data_source
        +text description
        +int order
        +bool is_active
        +timestamps
        --
        +hasMany ahpMatricesAsRow()
        +hasMany ahpMatricesAsCol()
        +hasMany weights()
        +hasMany studentValues()
        --
        +scopeForSpecialization(spec)
        +scopeActive()
        +scopeOrdered()
    }

    class AhpMatrix {
        +int id
        +int academic_year_id
        +string specialization
        +int criteria_row_id
        +int criteria_col_id
        +decimal comparison_value
        +text notes
        +timestamps
        --
        +belongsTo academicYear()
        +belongsTo criteriaRow()
        +belongsTo criteriaCol()
        --
        +scopeForAcademicYear(yearId)
        +scopeForSpecialization(spec)
        +scopeWithRelations()
        +static getMatrixData(yearId, spec)
        +static isMatrixComplete(yearId, spec)
        +static calculateConsistencyRatio(yearId, spec)
        +static getPriorityWeights(yearId, spec)
    }

    class CriterionWeight {
        +int id
        +int criteria_id
        +int academic_year_id
        +string specialization
        +decimal weight
        +string calculation_method
        +text notes
        +timestamps
        --
        +belongsTo criteria()
        +belongsTo academicYear()
    }

    class StudentCriterionValue {
        +int id
        +int student_id
        +int criteria_id
        +decimal raw_value
        +decimal normalized_value
        +text notes
        +timestamps
        --
        +belongsTo student()
        +belongsTo criteria()
        --
        +scopeForStudent(studentId)
        +scopeForCriteria(criteriaId)
    }

    %% ========================================
    %% SAW RESULTS
    %% ========================================

    class SawResult {
        +int id
        +int student_id
        +int academic_year_id
        +string specialization
        +decimal final_score
        +int rank
        +json detail_calculation
        +datetime calculated_at
        +int calculated_by
        +timestamps
        --
        +belongsTo student()
        +belongsTo academicYear()
        +belongsTo calculator()
        --
        +scopeForAcademicYearAndSpecialization(yearId, spec)
        +scopeRanked()
        +scopeByScore()
    }

    class FinalScore {
        +int id
        +int student_id
        +decimal academic_score
        +decimal test_score
        +decimal total_score
        +timestamps
        --
        +belongsTo student()
    }

    %% ========================================
    %% WEBSITE CONTENT
    %% ========================================

    class Announcement {
        +int id
        +string title
        +text content
        +string image_path
        +string file_path
        +bool is_active
        +datetime published_at
        +int created_by
        +timestamps
        --
        +belongsTo creator()
        --
        +scopeActive()
        +scopePublished()
        +scopeLatestFirst()
        --
        +static createAnnouncement(data)
        +bool updateAnnouncement(data)
        +bool toggleStatus()
        +bool publish()
        +bool unpublish()
        +bool deleteImage()
        +bool deleteFile()
        +string getStatusBadgeAttribute()
        +string getImageUrlAttribute()
        +string getExcerptAttribute()
        +bool getIsPublishedAttribute()
    }

    class HeroSection {
        +int id
        +string badge_text
        +string title_main
        +string title_italic
        +text subtitle
        +string btn_primary_label
        +string btn_primary_url
        +string btn_outline_label
        +string btn_outline_url
        +string background_image
        +bool is_active
        +timestamps
        --
        +hasMany stats()
        --
        +static getActive()
    }

    class HeroStat {
        +int id
        +int hero_section_id
        +string icon
        +string value
        +string label
        +int urutan
        +timestamps
        --
        +belongsTo heroSection()
    }

    class PpdbSetting {
        +int id
        +string tahun_ajaran
        +string telepon
        +string jam_operasional
        +date tanggal_buka
        +date tanggal_tutup
        +text catatan_beasiswa
        +string link_pendaftaran
        +bool is_active
        +timestamps
        --
        +static getActive()
        +bool isPendaftaranBuka()
    }

    class PpdbBiaya {
        +int id
        +string nama_biaya
        +decimal nominal
        +text keterangan
        +int urutan
        +bool is_active
        +timestamps
    }

    class PpdbPersyaratan {
        +int id
        +string nama_persyaratan
        +text deskripsi
        +int urutan
        +bool is_active
        +timestamps
    }

    class JadwalPpdb {
        +int id
        +string nama_kegiatan
        +date tanggal_mulai
        +date tanggal_selesai
        +text keterangan
        +int urutan
        +bool is_active
        +timestamps
    }

    class GaleriItem {
        +int id
        +string title
        +text description
        +string image_path
        +string category
        +int urutan
        +bool is_active
        +timestamps
    }

    class SelectionProcessLog {
        +int id
        +int academic_year_id
        +string process_type
        +string specialization
        +text description
        +json metadata
        +int performed_by
        +timestamps
        --
        +belongsTo academicYear()
        +belongsTo performer()
    }

    %% ========================================
    %% SERVICE LAYER (Conceptual)
    %% ========================================

    class ValidationService {
        <<service>>
        +approveStudent(student, validatedBy, notes)
        +rejectStudent(student, validatedBy, notes)
        +resubmitStudent(student, notes)
        +validateStudentCompleteness(student)
        +validateDocument(document, status, notes)
        +getValidationDetails(student)
        +canApprove(student)
        +batchApproveStudents(studentIds, validatedBy)
    }

    class AhpService {
        <<service>>
        +createMatrix(academicYearId, specialization, data)
        +getMatrixData(academicYearId, specialization)
        +calculateConsistencyRatio(academicYearId, specialization)
        +calculatePriorityWeights(academicYearId, specialization)
        +saveWeights(academicYearId, specialization, weights)
        +isMatrixComplete(academicYearId, specialization)
    }

    class SawService {
        <<service>>
        +calculateSaw(academicYearId, specialization)
        +normalizeValues(studentValues, criteria)
        +calculateFinalScores(normalizedValues, weights)
        +assignRanking(finalScores)
        +determineAcceptance(rankings, quota)
        +saveSawResults(results)
    }

    class RankingService {
        <<service>>
        +getRankingBySpecialization(academicYearId, spec)
        +getStudentRank(studentId, academicYearId)
        +getAcceptedStudents(academicYearId, spec)
        +getRejectedStudents(academicYearId, spec)
        +getRankingStatistics(academicYearId)
    }

    %% ========================================
    %% RELATIONSHIPS
    %% ========================================

    %% Core Relationships
    User "1" --> "0..1" Student : has
    Student "0..*" --> "1" User : belongs to
    Student "0..*" --> "1" AcademicYear : belongs to
    AcademicYear "1" --> "0..*" Student : has many
    AcademicYear "1" --> "0..*" SpecializationQuota : has many
    SpecializationQuota "0..*" --> "1" AcademicYear : belongs to

    %% Student Data Relationships
    Student "1" --> "0..1" ReportGrade : has
    ReportGrade "1" --> "1" Student : belongs to
    Student "1" --> "0..*" Document : has many
    Document "0..*" --> "1" Student : belongs to
    Student "1" --> "0..1" TestScore : has
    TestScore "1" --> "1" Student : belongs to
    TestScore "0..*" --> "1" User : input by
    Student "1" --> "0..*" ValidationLog : has many
    ValidationLog "0..*" --> "1" Student : belongs to
    ValidationLog "0..*" --> "1" User : actor

    %% AHP & Criteria Relationships
    Criteria "1" --> "0..*" AhpMatrix : row criteria
    Criteria "1" --> "0..*" AhpMatrix : col criteria
    AhpMatrix "0..*" --> "1" Criteria : belongs to row
    AhpMatrix "0..*" --> "1" Criteria : belongs to col
    Criteria "1" --> "0..*" CriterionWeight : has many
    CriterionWeight "0..*" --> "1" Criteria : belongs to
    Criteria "1" --> "0..*" StudentCriterionValue : has many
    StudentCriterionValue "0..*" --> "1" Criteria : belongs to
    Student "1" --> "0..*" StudentCriterionValue : has many
    StudentCriterionValue "0..*" --> "1" Student : belongs to
    AcademicYear "1" --> "0..*" AhpMatrix : has many
    AhpMatrix "0..*" --> "1" AcademicYear : belongs to
    AcademicYear "1" --> "0..*" CriterionWeight : has many
    CriterionWeight "0..*" --> "1" AcademicYear : belongs to

    %% SAW Results Relationships
    Student "1" --> "0..*" SawResult : has many
    SawResult "0..*" --> "1" Student : belongs to
    Student "1" --> "0..1" FinalScore : has
    FinalScore "1" --> "1" Student : belongs to
    AcademicYear "1" --> "0..*" SawResult : has many
    SawResult "0..*" --> "1" AcademicYear : belongs to
    User "1" --> "0..*" SawResult : calculated by
    SawResult "0..*" --> "1" User : calculator

    %% Website Content Relationships
    User "1" --> "0..*" Announcement : creates
    Announcement "0..*" --> "1" User : created by
    HeroSection "1" --> "0..*" HeroStat : has many
    HeroStat "0..*" --> "1" HeroSection : belongs to

    %% Process Log Relationships
    AcademicYear "1" --> "0..*" SelectionProcessLog : has many
    SelectionProcessLog "0..*" --> "1" AcademicYear : belongs to
    User "1" --> "0..*" SelectionProcessLog : performs
    SelectionProcessLog "0..*" --> "1" User : performed by

    %% Service Dependencies (Conceptual)
    ValidationService ..> Student : uses
    ValidationService ..> Document : uses
    ValidationService ..> ValidationLog : uses
    AhpService ..> Criteria : uses
    AhpService ..> AhpMatrix : uses
    AhpService ..> CriterionWeight : uses
    SawService ..> Student : uses
    SawService ..> StudentCriterionValue : uses
    SawService ..> SawResult : uses
    SawService ..> CriterionWeight : uses
    RankingService ..> SawResult : uses
    RankingService ..> SpecializationQuota : uses

    %% ========================================
    %% NOTES
    %% ========================================

    note for Student "Central entity: connects user data,\nvalidation process, and selection results.\nHas 30+ attributes and 25+ methods."

    note for SawResult "Stores final ranking and acceptance status.\nDetail calculation saved as JSON.\nData locked after calculation."

    note for AhpMatrix "Pairwise comparison matrix for AHP.\nConsistency Ratio (CR) must be ≤ 0.1.\nPriority weights extracted from eigenvector."

    note for ValidationService "Handles all validation logic:\n- Document validation\n- Student approval/rejection\n- Resubmission tracking\n- Completeness checking"

    note for AhpService "Implements AHP algorithm:\n- Matrix completion check\n- Consistency ratio calculation\n- Priority weight extraction\n- Weight persistence"

    note for SawService "Implements SAW algorithm:\n- Value normalization (benefit/cost)\n- Weighted score calculation\n- Ranking assignment\n- Acceptance determination"
