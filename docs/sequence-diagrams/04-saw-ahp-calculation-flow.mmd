sequenceDiagram
    participant Admin
    participant Committee
    participant Browser
    participant AhpController
    participant CriterionController
    participant AhpService
    participant SawService
    participant RankingService
    participant Database

    Note over Admin,Database: SAW & AHP Calculation Flow

    %% Step 1: Admin Setup Criteria
    rect rgb(200, 220, 255)
        Note right of Admin: Step 1: Setup Criteria (Admin)
        Admin->>Browser: Access /admin/criterias
        Browser->>AhpController: GET criterias.index
        AhpController->>Database: Get all criteria
        Database-->>AhpController: Criteria list
        AhpController-->>Browser: Show criteria page
        Admin->>Browser: Create/Edit criteria
        Browser->>AhpController: POST/PUT criteria
        AhpController->>Database: Save criteria
        Database-->>AhpController: Criteria saved
        AhpController-->>Browser: Success message
    end

    %% Step 2: Admin Calculate AHP Weights
    rect rgb(255, 220, 200)
        Note right of Admin: Step 2: Calculate AHP Weights (Admin)
        Admin->>Browser: Access /admin/ahp-matrices
        Browser->>AhpController: GET ahp-matrices.index
        AhpController->>Database: Get criteria & matrices
        Database-->>AhpController: Matrices data
        AhpController-->>Browser: Show AHP matrix form
        Admin->>Browser: Input pairwise comparisons
        Browser->>AhpController: POST ahp-matrices
        AhpController->>Database: Save comparison matrices
        Admin->>Browser: Click "Calculate Weights"
        Browser->>AhpController: POST calculate-weights
        
        AhpController->>Database: Check pending students
        alt Has pending students
            Database-->>AhpController: Pending students exist
            AhpController-->>Browser: Error: Validate all students first
        else All students validated
            AhpController->>AhpService: calculateWeights()
            AhpService->>AhpService: Build comparison matrix
            AhpService->>AhpService: Calculate eigenvector
            AhpService->>AhpService: Calculate consistency ratio
            alt CR > 0.1
                AhpService-->>AhpController: Error: Inconsistent matrix
            else CR <= 0.1
                AhpService->>Database: Save criterion weights
                Database-->>AhpService: Weights saved
                AhpService-->>AhpController: Success
                AhpController-->>Browser: Show weights & CR
            end
        end
    end

    %% Step 3: Committee Input Criterion Values
    rect rgb(220, 255, 200)
        Note right of Committee: Step 3: Input Criterion Values (Committee)
        Committee->>Browser: Access /committee/criterion-values
        Browser->>CriterionController: GET criterion-values.index
        CriterionController->>Database: Get students list
        Database-->>CriterionController: Students data
        CriterionController-->>Browser: Show students list
        
        loop For each student
            Committee->>Browser: Click "Input Nilai"
            Browser->>CriterionController: GET create/{student}
            CriterionController->>Database: Get criteria & student
            Database-->>CriterionController: Criteria list
            CriterionController-->>Browser: Show input form
            Committee->>Browser: Input criterion values
            Browser->>CriterionController: POST store/{student}
            CriterionController->>Database: Save criterion values
            Database-->>CriterionController: Values saved
        end
        
        Note right of Committee: Or use batch sync
        Committee->>Browser: Click "Sync Nilai Rapor"
        Browser->>CriterionController: POST batch-sync-report-grade
        CriterionController->>Database: Sync all report grades to criteria
        Database-->>CriterionController: All synced
    end

    %% Step 4: Calculate SAW
    rect rgb(255, 255, 200)
        Note right of Committee: Step 4: Calculate SAW (Committee)
        Committee->>Browser: Click "Hitung SAW"
        Browser->>CriterionController: POST calculate-saw
        
        CriterionController->>Database: Check pending students
        alt Has pending students
            Database-->>CriterionController: Pending students exist
            CriterionController-->>Browser: Error: Validate all students first
        else All students validated
            CriterionController->>SawService: calculateSaw()
            
            loop For each specialization (Tahfiz, Language)
                SawService->>Database: Get students by specialization
                SawService->>Database: Get criteria weights
                SawService->>Database: Get criterion values
                
                SawService->>SawService: Normalize values (benefit/cost)
                Note right of SawService: Benefit: value/max<br/>Cost: min/value
                
                SawService->>SawService: Calculate weighted scores
                Note right of SawService: Score = Σ(normalized × weight)
                
                SawService->>Database: Save SAW results
            end
            
            Database-->>SawService: SAW results saved
            SawService-->>CriterionController: Success
            CriterionController-->>Browser: Show success message
        end
    end

    %% Step 5: Determine Acceptance
    rect rgb(200, 255, 255)
        Note right of Committee: Step 5: Determine Acceptance (Committee)
        Committee->>Browser: Click "Tentukan Penerimaan"
        Browser->>CriterionController: POST determine-acceptance
        CriterionController->>RankingService: determineAcceptance()
        
        RankingService->>Database: Get SAW results
        RankingService->>Database: Get specialization quotas
        
        loop For each specialization
            RankingService->>RankingService: Rank students by SAW score
            RankingService->>RankingService: Compare rank with quota
            
            alt Rank <= Quota
                RankingService->>Database: Set status = 'accepted'
            else Rank > Quota
                RankingService->>Database: Set status = 'rejected'
            end
        end
        
        RankingService->>Database: Update all student statuses
        Database-->>RankingService: Statuses updated
        RankingService-->>CriterionController: Success
        CriterionController-->>Browser: Show acceptance results
    end

    %% Step 6: View Results
    rect rgb(255, 200, 255)
        Note right of Committee: Step 6: View SAW Results
        Committee->>Browser: Access /committee/saw-results
        Browser->>CriterionController: GET saw-results.index
        CriterionController->>Database: Get SAW results with ranking
        Database-->>CriterionController: Results data
        CriterionController-->>Browser: Show ranking table
        Browser-->>Committee: Display rankings by specialization
    end

    Note over Admin,Database: SAW/AHP Calculation Complete
