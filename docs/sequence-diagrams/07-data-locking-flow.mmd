sequenceDiagram
    participant Student
    participant Browser
    participant Controller
    participant StudentModel
    participant Database

    Note over Student,Database: Data Locking After SAW Calculation

    %% Before SAW Calculation
    rect rgb(200, 255, 200)
        Note right of Student: Before SAW: Data Can Be Edited
        Student->>Browser: Access /student/profile
        Browser->>Controller: GET profile.index
        Controller->>StudentModel: canEditData()
        StudentModel->>Database: Check SAW results
        Database-->>StudentModel: No SAW results
        StudentModel-->>Controller: can_edit = true
        Controller-->>Browser: Show editable form
        Browser-->>Student: Can edit all fields
        
        Student->>Browser: Update data
        Browser->>Controller: PUT profile.update
        Controller->>StudentModel: canEditData()
        StudentModel-->>Controller: can_edit = true
        Controller->>Database: Update student data
        Database-->>Controller: Data updated
        Controller-->>Browser: Success message
    end

    %% Committee Calculates SAW
    rect rgb(255, 220, 200)
        Note right of Student: Committee Calculates SAW
        Browser->>Controller: POST calculate-saw
        Controller->>Database: Save SAW results for all students
        Database-->>Controller: SAW results saved
        Note over Database: Students now have SAW results<br/>Data becomes locked
    end

    %% After SAW Calculation - Profile
    rect rgb(255, 200, 200)
        Note right of Student: After SAW: Profile Locked
        Student->>Browser: Access /student/profile
        Browser->>Controller: GET profile.index
        Controller->>StudentModel: canEditData()
        StudentModel->>Database: Check SAW results
        Database-->>StudentModel: SAW results exist
        StudentModel-->>Controller: can_edit = false<br/>reason = "Data terkunci"
        Controller-->>Browser: Show locked form + alert
        Browser-->>Student: Display yellow alert
        Note right of Student: Alert: "Data tidak dapat diubah<br/>karena perhitungan ranking<br/>telah dilakukan"
        Browser-->>Student: All inputs disabled (gray)
        Browser-->>Student: Submit button hidden
        
        Student->>Browser: Try to update (via URL)
        Browser->>Controller: PUT profile.update
        Controller->>StudentModel: canEditData()
        StudentModel-->>Controller: can_edit = false
        Controller-->>Browser: Error: Data locked
        Browser-->>Student: Show error message
    end

    %% After SAW Calculation - Report Grades
    rect rgb(255, 200, 200)
        Note right of Student: After SAW: Report Grades Locked
        Student->>Browser: Access /student/report-grades
        Browser->>Controller: GET report-grades.index
        Controller->>StudentModel: canEditData()
        StudentModel-->>Controller: can_edit = false
        Controller-->>Browser: Show locked page + alert
        Browser-->>Student: Display yellow alert
        Browser-->>Student: Edit/Delete buttons hidden
        Browser-->>Student: Only view mode available
    end

    %% After SAW Calculation - Specialization
    rect rgb(255, 200, 200)
        Note right of Student: After SAW: Specialization Locked
        Student->>Browser: Access /student/specialization
        Browser->>Controller: GET specialization.index
        Controller->>StudentModel: canEditData()
        StudentModel-->>Controller: can_edit = false
        Controller-->>Browser: Show locked page + alert
        Browser-->>Student: Display yellow alert
        Browser-->>Student: "Ubah Pilihan" button hidden
        Browser-->>Student: Current choice displayed (read-only)
    end

    %% After SAW Calculation - Documents
    rect rgb(255, 200, 200)
        Note right of Student: After SAW: Documents Locked
        Student->>Browser: Access /student/documents
        Browser->>Controller: GET documents.index
        Controller->>StudentModel: canEditData()
        StudentModel-->>Controller: can_edit = false
        Controller-->>Browser: Show locked page + alert
        Browser-->>Student: Display yellow alert
        Browser-->>Student: Upload/Edit/Delete buttons hidden
        Browser-->>Student: Only view/download available
    end

    %% Committee Cannot Calculate if Pending
    rect rgb(255, 255, 200)
        Note right of Student: Committee Validation Check
        Browser->>Controller: POST calculate-saw
        Controller->>Database: Check pending students
        
        alt Has pending students
            Database-->>Controller: Found X pending students
            Controller-->>Browser: Error message
            Note right of Browser: "Tidak dapat menghitung SAW.<br/>Masih ada X siswa dengan<br/>status validasi 'pending'"
        else All students validated
            Controller->>Database: Proceed with SAW calculation
            Database-->>Controller: SAW calculated
            Note over Database: All student data now locked
        end
    end

    %% Data Locking Logic
    rect rgb(200, 220, 255)
        Note right of StudentModel: canEditData() Logic
        StudentModel->>Database: hasSawCalculation()
        
        alt SAW results exist
            Database-->>StudentModel: true
            StudentModel-->>Controller: Return:<br/>can_edit = false<br/>reason = "Data terkunci"
        else No SAW results
            Database-->>StudentModel: false
            StudentModel-->>Controller: Return:<br/>can_edit = true<br/>reason = null
        end
    end

    Note over Student,Database: Data Protection Complete
